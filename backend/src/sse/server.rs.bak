use actix::prelude::*;
use actix_web::http::header::{ContentType, CACHE_CONTROL, CONNECTION};
use actix_web::web::Bytes;
use actix_web::web::Payload;
use actix_web::{web, Error, HttpRequest, HttpResponse, Responder};
use futures::stream::{self, Stream};
use futures::{FutureExt, StreamExt};
use log::{debug, error, info, warn};
use mime::TEXT_EVENT_STREAM;
use serde::{Deserialize, Serialize};
use serde_json::json;
use std::collections::HashMap;
use std::pin::Pin;
use std::time::Duration;
use std::time::{Duration, Instant};
use tokio::sync::mpsc;
use tokio::time::interval;
use tokio_stream::wrappers::ReceiverStream;
use tokio_stream::StreamExt;
use utoipa::ToSchema;
use uuid::Uuid;

use crate::middleware::auth::validate_token;
use crate::sse::messages::{
    BroadcastMessage, ClientConnect, ClientDisconnect, ConnectSSE, DisconnectSSE, GetSessionStatus,
    PollForEvents, ServerMessage,
};
use crate::sse::session::SessionManager;
use crate::utils::jwt;

// Type alias for the SSE stream
type EventStream = Pin<Box<dyn Stream<Item = Result<Bytes, Error>> + Send>>;

/// SSE connection handler
#[utoipa::path(
    get,
    path = "/api/v1/sessions/{session_id}/events",
    params(
        ("session_id" = String, Path, description = "Session ID to connect to"),
        ("token" = String, Query, description = "JWT authentication token")
    ),
    responses(
        (status = 200, description = "SSE connection established successfully", content_type = "text/event-stream"),
        (status = 401, description = "Unauthorized - Invalid or missing token"),
        (status = 404, description = "Session not found")
    ),
    security(
        ("bearer_auth" = [])
    ),
    tag = "realtime"
)]
pub async fn events_route(
    req: HttpRequest,
    path: web::Path<String>,
    query: web::Query<HashMap<String, String>>,
    session_manager: web::Data<Addr<SessionManager>>,
) -> Result<HttpResponse, Error> {
    let session_id = path.into_inner();

    // Try to get token from Authorization header first (more secure)
    let auth_header = req.headers().get("Authorization");
    let token_from_header = auth_header.and_then(|h| {
        let header_str = h.to_str().ok()?;
        if header_str.starts_with("Bearer ") {
            Some(header_str[7..].to_string())
        } else {
            None
        }
    });

    // Fall back to query parameter if header is not present
    let token_from_query = query.get("token").cloned();

    // Use header token if available, otherwise use query token
    let token = token_from_header.or(token_from_query);

    // Debug log to help troubleshoot authentication issues
    if token.is_none() {
        warn!(
            "No token found in request. Headers: {:?}, Query params: {:?}",
            req.headers().iter().collect::<Vec<_>>(),
            query.iter().collect::<Vec<_>>()
        );
    }

    // Validate token
    if let Some(token) = token {
        match jwt::validate_token(&token) {
            Ok(claims) => {
                info!("SSE connection authorized for user: {}", claims.sub);

                // Create channel for sending events to client
                let (tx, rx) = mpsc::channel::<ServerMessage>(100);

                // Register client with session manager
                session_manager.do_send(ConnectSSE {
                    client_id: claims.sub.clone(),
                    session_id: session_id.clone(),
                    sender: tx,
                });

                // Create stream from receiver
                let event_stream =
                    tokio_stream::StreamExt::map(ReceiverStream::new(rx), move |msg| {
                        let event_type = &msg.message_type;
                        let data = match serde_json::to_string(&msg.data) {
                            Ok(json) => json,
                            Err(e) => {
                                error!("Failed to serialize message data: {:?}", e);
                                String::from("{}")
                            }
                        };

                        // Format as SSE event and convert to Bytes
                        let event_string = format!("event: {}\ndata: {}\n\n", event_type, data);
                        Ok::<_, Error>(Bytes::from(event_string))
                    });

                // Create keep-alive stream
                let keep_alive = stream::repeat_with(|| {
                    let ping_data = format!(
                        "event: ping\ndata: {}\n\n",
                        serde_json::to_string(
                            &json!({"timestamp": chrono::Utc::now().timestamp()})
                        )
                        .unwrap_or_default()
                    );
                    Ok::<_, Error>(Bytes::from(ping_data))
                });

                // Apply throttle using tokio_stream::StreamExt
                let throttled_keep_alive =
                    tokio_stream::StreamExt::throttle(keep_alive, Duration::from_secs(30));

                // Merge the streams - use the method directly on the stream
                let stream = event_stream.merge(throttled_keep_alive);

                // Store client ID and session ID for cleanup when connection closes
                let client_id = claims.sub.clone();
                let session_id_clone = session_id.clone();
                let session_manager_clone = session_manager.clone();

                // Create a response with streaming body
                let response = HttpResponse::Ok()
                    .content_type(TEXT_EVENT_STREAM)
                    .insert_header((CACHE_CONTROL, "no-cache"))
                    .insert_header((CONNECTION, "keep-alive"))
                    .streaming(stream);

                // Set up a task to handle disconnection
                actix_web::rt::spawn(async move {
                    // This will be called when the client disconnects
                    debug!("SSE connection closed for user: {}", client_id);
                    session_manager_clone.do_send(DisconnectSSE {
                        client_id: client_id.clone(),
                        session_id: session_id_clone.clone(),
                    });
                });

                Ok(response)
            }
            Err(e) => {
                error!("Token verification failed: {:?}", e);
                Ok(HttpResponse::Unauthorized().json(json!({
                    "status": "error",
                    "message": "Invalid token"
                })))
            }
        }
    } else {
        Ok(HttpResponse::Unauthorized().json(json!({
            "status": "error",
            "message": "Missing token"
        })))
    }
}

/// Poll endpoint for clients that want to use Authorization headers
#[utoipa::path(
    get,
    path = "/api/v1/sessions/{session_id}/events/poll",
    params(
        ("session_id" = String, Path, description = "Session ID to connect to"),
        ("since" = i64, Query, description = "Timestamp to filter events since")
    ),
    responses(
        (status = 200, description = "Events retrieved successfully"),
        (status = 401, description = "Unauthorized - Invalid or missing token"),
        (status = 404, description = "Session not found")
    ),
    security(
        ("bearer_auth" = [])
    ),
    tag = "realtime"
)]
pub async fn events_poll_route(
    req: HttpRequest,
    path: web::Path<String>,
    query: web::Query<HashMap<String, String>>,
    session_manager: web::Data<Addr<SessionManager>>,
) -> Result<HttpResponse, Error> {
    let session_id = path.into_inner();

    info!("Received poll request for session: {}", session_id);

    // Get token from Authorization header
    let auth_header = req.headers().get("Authorization");
    let token = auth_header.and_then(|h| {
        let header_str = h.to_str().ok()?;
        if header_str.starts_with("Bearer ") {
            Some(header_str[7..].to_string())
        } else {
            None
        }
    });

    // Get the 'since' timestamp from query parameters
    let since_timestamp = query
        .get("since")
        .and_then(|s| s.parse::<i64>().ok())
        .unwrap_or(0);

    debug!("Poll request with since timestamp: {}", since_timestamp);

    // Debug log to help troubleshoot authentication issues
    if token.is_none() {
        warn!(
            "No token found in request headers: {:?}",
            req.headers().iter().collect::<Vec<_>>()
        );
        return Ok(HttpResponse::Unauthorized().json(json!({
            "status": "error",
            "message": "Missing Authorization header"
        })));
    }

    // Validate token
    if let Some(token) = token {
        match jwt::validate_token(&token) {
            Ok(claims) => {
                info!(
                    "Poll request authorized for user: {} for session: {}",
                    claims.sub, session_id
                );

                // Get recent events from the session manager
                let events = session_manager
                    .send(crate::sse::messages::GetRecentEvents {
                        session_id: session_id.clone(),
                        client_id: claims.sub.clone(),
                        since_timestamp,
                    })
                    .await
                    .unwrap_or_else(|_| Ok(vec![]))
                    .unwrap_or_else(|_| vec![]);

                info!(
                    "Retrieved {} events for session {} since {}",
                    events.len(),
                    session_id,
                    since_timestamp
                );

                // Log the types of events retrieved
                for (i, event) in events.iter().enumerate() {
                    debug!(
                        "Event {}: type={}, data={}",
                        i, event.message_type, event.data
                    );
                }

                // Get the current timestamp for the client to use in the next request
                let current_timestamp = chrono::Utc::now().timestamp();

                // Convert events to a format suitable for JSON response
                let events_json = events
                    .into_iter()
                    .map(|msg| {
                        json!({
                            "type": msg.message_type,
                            "data": msg.data,
                            "timestamp": msg.timestamp
                        })
                    })
                    .collect::<Vec<_>>();

                Ok(HttpResponse::Ok().json(json!({
                    "status": "success",
                    "session_id": session_id,
                    "timestamp": current_timestamp,
                    "ping": {
                        "timestamp": current_timestamp
                    },
                    "events": events_json
                })))
            }
            Err(e) => {
                error!("Token verification failed: {:?}", e);
                Ok(HttpResponse::Unauthorized().json(json!({
                    "status": "error",
                    "message": "Invalid token"
                })))
            }
        }
    } else {
        Ok(HttpResponse::Unauthorized().json(json!({
            "status": "error",
            "message": "Missing token"
        })))
    }
}

/// SSE connection handler with POST authentication
#[utoipa::path(
    post,
    path = "/api/v1/sessions/{session_id}/events/connect",
    params(
        ("session_id" = String, Path, description = "Session ID to connect to")
    ),
    request_body(content = AuthRequest, description = "Authentication token", content_type = "application/json"),
    responses(
        (status = 200, description = "SSE connection established successfully", content_type = "text/event-stream"),
        (status = 401, description = "Unauthorized - Invalid or missing token"),
        (status = 404, description = "Session not found")
    ),
    security(
        ("bearer_auth" = [])
    ),
    tag = "realtime"
)]
pub async fn events_connect_route(
    req: HttpRequest,
    path: web::Path<String>,
    auth_body: web::Json<AuthRequest>,
    session_manager: web::Data<Addr<SessionManager>>,
) -> Result<HttpResponse, Error> {
    let session_id = path.into_inner();
    info!("Received SSE connect request for session: {}", session_id);

    // Get token from request body
    let token = auth_body.token.clone();

    // Validate token
    match jwt::validate_token(&token) {
        Ok(claims) => {
            info!("SSE connection authorized for user: {}", claims.sub);

            // Create channel for sending events to client
            let (tx, rx) = mpsc::channel::<ServerMessage>(100);

            // Register client with session manager
            session_manager.do_send(ConnectSSE {
                client_id: claims.sub.clone(),
                session_id: session_id.clone(),
                sender: tx,
            });

            // Create stream from receiver
            let event_stream = tokio_stream::StreamExt::map(ReceiverStream::new(rx), move |msg| {
                let event_type = &msg.message_type;
                let data = match serde_json::to_string(&msg.data) {
                    Ok(json) => json,
                    Err(e) => {
                        error!("Failed to serialize message data: {:?}", e);
                        String::from("{}")
                    }
                };

                // Format as SSE event and convert to Bytes
                let event_string = format!("event: {}\ndata: {}\n\n", event_type, data);
                Ok::<_, Error>(Bytes::from(event_string))
            });

            // Create keep-alive stream
            let keep_alive = stream::repeat_with(|| {
                let ping_data = format!(
                    "event: ping\ndata: {}\n\n",
                    serde_json::to_string(&json!({"timestamp": chrono::Utc::now().timestamp()}))
                        .unwrap_or_default()
                );
                Ok::<_, Error>(Bytes::from(ping_data))
            });

            // Apply throttle using tokio_stream::StreamExt
            let throttled_keep_alive =
                tokio_stream::StreamExt::throttle(keep_alive, Duration::from_secs(30));

            // Merge the streams - use the method directly on the stream
            let stream = event_stream.merge(throttled_keep_alive);

            // Store client ID and session ID for cleanup when connection closes
            let client_id = claims.sub.clone();
            let session_id_clone = session_id.clone();
            let session_manager_clone = session_manager.clone();

            // Create a response with streaming body
            let response = HttpResponse::Ok()
                .content_type(TEXT_EVENT_STREAM)
                .insert_header((CACHE_CONTROL, "no-cache"))
                .insert_header((CONNECTION, "keep-alive"))
                .streaming(stream);

            // Set up a task to handle disconnection
            actix_web::rt::spawn(async move {
                // This will be called when the client disconnects
                debug!("SSE connection closed for user: {}", client_id);
                session_manager_clone.do_send(DisconnectSSE {
                    client_id: client_id.clone(),
                    session_id: session_id_clone.clone(),
                });
            });

            Ok(response)
        }
        Err(e) => {
            error!("Token verification failed: {:?}", e);
            Ok(HttpResponse::Unauthorized().json(json!({
                "status": "error",
                "message": "Invalid token"
            })))
        }
    }
}

// Authentication request structure
#[derive(Debug, Deserialize, Serialize, ToSchema)]
pub struct AuthRequest {
    pub token: String,
}

// New endpoint to check the status of SSE connections
pub async fn events_status(sse_session_manager: web::Data<Addr<SessionManager>>) -> impl Responder {
    // Get the status from the session manager
    let status_result = sse_session_manager.send(GetSessionStatus {}).await;

    match status_result {
        Ok(status) => HttpResponse::Ok().json(status),
        Err(e) => {
            error!("Failed to get SSE status: {:?}", e);
            HttpResponse::InternalServerError().json(json!({
                "error": "Failed to get SSE status"
            }))
        }
    }
}
